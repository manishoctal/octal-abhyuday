<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon foreground (API 24+): "A" lettermark on transparent background.
     evenOdd fill rule punches the inner triangle out to transparent, so the background
     layer color (#0F1035) shows through the hollow of the A. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Outer A triangle minus inner cutout (evenOdd = transparent hole) -->
    <path
        android:fillColor="#FF7A00"
        android:fillType="evenOdd"
        android:pathData="M54,20 L84,80 L24,80 Z M54,33 L32,77 L76,77 Z"/>
    <!-- Crossbar -->
    <path
        android:fillColor="#FF7A00"
        android:pathData="M41,59 L67,59 L67,67 L41,67 Z"/>
</vector>
