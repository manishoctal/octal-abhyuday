# ── Server ─────────────────────────────────────────────────────────────────────
# Port the Next.js server listens on. Defaults to 3000.
# Set this to run multiple instances on the same Ubuntu server.
PORT=3000

# ── Auth ────────────────────────────────────────────────────────────────────────
# OTP accepted at login (temporary stub until real OTP delivery is wired up)
OTP_CODE=1234

# Comma-separated admin emails — these users get the /admin panel
ADMIN_EMAILS=manish.prajapati@octalsoftware.com

# Only emails on this domain can sign in
ALLOWED_EMAIL_DOMAIN=octalsoftware.com

# Secret for signing session cookies (JWT). Use a long random string in production.
# Generate: openssl rand -hex 48
JWT_SECRET=change-me-to-a-long-random-string

# ── Database ────────────────────────────────────────────────────────────────────
# SQLite database lives in ./data/vote.db (inside the project).
# The data/ directory is committed to git (via .gitkeep) so it always exists.
# Only set DATA_DIR if you want to move it elsewhere (e.g. a separate mounted disk).
# DATA_DIR=/var/data

# ── Push Notifications (Web Push / VAPID) ───────────────────────────────────────
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=manish.prajapati@octalsoftware.com

# ── AWS S3 + CloudFront — photo storage ─────────────────────────────────────────
# If these are set, gallery & profile photos upload directly to S3 via presigned URLs
# and are served through CloudFront. If not set, photos are stored on local disk.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=octal-event-photos

# CloudFront distribution URL (without trailing slash).
# If not set, falls back to direct S3 URL.
S3_PUBLIC_URL=https://d1f23llskj06r6.cloudfront.net
