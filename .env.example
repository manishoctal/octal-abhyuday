# Copy to .env.local for local dev. On Render these are set in render.yaml / the dashboard.

# OTP accepted at login (temporary stub until real OTP delivery is wired up)
OTP_CODE=1234

# Comma-separated admin emails — these users get the /admin panel
ADMIN_EMAILS=manish.prajapati@octalsoftware.com

# Only emails on this domain can sign in
ALLOWED_EMAIL_DOMAIN=octalsoftware.com

# Secret for signing session cookies (JWT). Use a long random string in production.
# On Render this is auto-generated (render.yaml: generateValue: true).
JWT_SECRET=change-me-to-a-long-random-string

# Where the SQLite database file (vote.db) is stored.
# Local: leave unset (defaults to ./data). Render: /var/data (the persistent disk).
# DATA_DIR=/var/data

# Push notifications (Web Push / VAPID).
# Generate keys with: npx web-push generate-vapid-keys
# Leave blank to disable push notifications (admin send button will show an error).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=manish.prajapati@octalsoftware.com

# AWS S3 — photo storage for gallery and profile photos (Phase 2).
# Leave blank if not yet configured.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=octal-event-photos
S3_PUBLIC_URL=https://octal-event-photos.s3.ap-south-1.amazonaws.com
